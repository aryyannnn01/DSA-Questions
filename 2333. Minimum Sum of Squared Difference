2333. Minimum Sum of Squared Difference


class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        int n = nums1.length;
        int[] freq = new int[100001];
        long sum = 0;

        for (int i = 0; i < n; i++) {
            int diff = Math.abs(nums1[i] - nums2[i]);
            freq[diff]++;
            sum += diff;
        }

        long k = (long) k1 + k2;

        if (k >= sum) {
            return 0;
        }

        for (int d = 100000; d > 0 && k > 0; d--) {
            if (freq[d] == 0) {
                continue;
            }

            long oper = Math.min(k, (long) freq[d]);
            freq[d] -= oper;
            freq[d - 1] += oper;
            k -= oper;
        }

        long ans = 0;

        for (int d = 0; d <= 100000; d++) {
            ans += (long) d * d * freq[d];
        }

        return ans;
    }
}
