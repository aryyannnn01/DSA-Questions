1111. Maximum Nesting Depth of Two Valid Parentheses Strings

class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int n = seq.length();
        int[] ans = new int[n];
        int len = 0;
        for(int i = 0; i < n; i++){
            if(seq.charAt(i) == '('){
                len++;
                ans[i] = len % 2;
            } else{
                ans[i] = len % 2;
                len--;
            }
        }

        return ans;
    }
}
