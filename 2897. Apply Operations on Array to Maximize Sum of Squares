2897. Apply Operations on Array to Maximize Sum of Squares

class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int MOD = 1000000007;
        int[] freq = new int[31];

        for(int num : nums){
            for(int bits = 0; bits < 31; bits++){
                if ((num & (1 << bits)) != 0) {
                    freq[bits]++;
                }
            }
        }

        long ans = 0;
        for(int i = 0; i < k; i++){
            long value = 0;

            for(int bits = 0; bits < 31; bits++){
                if(freq[bits] > 0){
                    value = value + (1 << bits);
                    freq[bits]--;
                }
            }

            ans = (ans + value * value) % MOD;
        }

        return (int) (ans);
    }
}
