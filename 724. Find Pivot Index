724. Find Pivot Index

class Solution {
    public int pivotIndex(int[] nums) {
        int n = nums.length;
        int rightSum = 0;
        int leftSum = 0;

        for(int i = 0; i < n; i++){
            rightSum += nums[i];
        }

        for(int i = 0; i < n; i++){
            if(leftSum == rightSum - leftSum - nums[i]){
                return i;
            }
            leftSum += nums[i];
        }

        return -1;
    }
}
