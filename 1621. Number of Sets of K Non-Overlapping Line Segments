1621. Number of Sets of K Non-Overlapping Line Segments

class Solution {

    private static final int M = 1000000007;

    public int numberOfSets(int n, int k) {
        int[] dp = new int[n];
        int[] pSum = new int[n + 1];
        for (int j = 0; j < n; j++) {
            dp[j] = 1;
            pSum[j + 1] = (pSum[j] + dp[j]) % M;
        }
        for (int i = 1; i <= k; i++) {
            dp[0] = 0;
            for (int j = 1; j < n; j++) {
                dp[j] = (dp[j - 1] + pSum[j]) % M;
            }
            for (int j = 0; j < n; j++) {
                pSum[j + 1] = (pSum[j] + dp[j]) % M;
            }
        }
        return dp[n - 1];
    }
}
