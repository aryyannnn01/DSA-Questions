3568. Minimum Moves to Clean the Classroom

import java.util.*;

class Solution {

    static class State {
        int r, c, energy, mask;

        State(int r, int c, int energy, int mask) {
            this.r = r;
            this.c = c;
            this.energy = energy;
            this.mask = mask;
        }
    }

    public int minMoves(String[] classroom, int energy) {

        int m = classroom.length;
        int n = classroom[0].length();

        int[][] litter = new int[m][n];

        for (int[] row : litter)
            Arrays.fill(row, -1);

        int sr = 0, sc = 0, k = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (classroom[i].charAt(j) == 'S') {
                    sr = i;
                    sc = j;
                }

                if (classroom[i].charAt(j) == 'L') {
                    litter[i][j] = k++;
                }
            }
        }

        if (k == 0)
            return 0;

        int all = (1 << k) - 1;

        boolean[][][][] visited = new boolean[m][n][energy + 1][1 << k];

        Queue<State> q = new ArrayDeque<>();
        q.add(new State(sr, sc, energy, 0));
        visited[sr][sc][energy][0] = true;

        int moves = 0;

        int[] dr = {0, 0, 1, -1};
        int[] dc = {1, -1, 0, 0};

        while (!q.isEmpty()) {

            int size = q.size();

            while (size-- > 0) {

                State cur = q.poll();

                if (cur.mask == all)
                    return moves;

                if (cur.energy == 0)
                    continue;

                for (int d = 0; d < 4; d++) {

                    int r = cur.r + dr[d];
                    int c = cur.c + dc[d];

                    if (r < 0 || r >= m || c < 0 || c >= n)
                        continue;

                    if (classroom[r].charAt(c) == 'X')
                        continue;

                    int newEnergy = cur.energy - 1;
                    int newMask = cur.mask;

                    if (classroom[r].charAt(c) == 'R')
                        newEnergy = energy;

                    if (classroom[r].charAt(c) == 'L')
                        newMask |= (1 << litter[r][c]);

                    if (!visited[r][c][newEnergy][newMask]) {

                        visited[r][c][newEnergy][newMask] = true;

                        q.add(new State(
                            r, c, newEnergy, newMask
                        ));
                    }
                }
            }

            moves++;
        }

        return -1;
    }
}
