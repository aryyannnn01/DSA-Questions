1406. Stone Game III


class Solution {

    public String stoneGameIII(int[] stones) {
        Integer[] dp = new Integer[stones.length];

        int diff = solve(stones, 0, dp);

        if (diff > 0)
            return "Alice";
        else if (diff < 0)
            return "Bob";
        else
            return "Tie";
    }

    public int solve(int[] stones, int i, Integer[] dp) {

        if (i >= stones.length)
            return 0;

        if (dp[i] != null)
            return dp[i];

        int result = stones[i] - solve(stones, i + 1, dp);

        if (i + 1 < stones.length) {
            result = Math.max(result,
                    stones[i] + stones[i + 1] - solve(stones, i + 2, dp));
        }

        if (i + 2 < stones.length) {
            result = Math.max(result,
                    stones[i] + stones[i + 1] + stones[i + 2]
                            - solve(stones, i + 3, dp));
        }

        dp[i] = result;
        return dp[i];
    }
}
