2472. Maximum Number of Non-overlapping Palindrome Substrings

class Solution {
    int n;
    int dp[][];
    boolean pal[][];
    public int maxPalindromes(String s, int k) {
        n = s.length();

        dp = new int[n][n];
        for(int[] row : dp){
            Arrays.fill(row, -1);
        }

        pal = new boolean[n][n];

        for(int i = n - 1; i >= 0; i--){
            for(int j = i; j < n; j++){
                if(s.charAt(i) == s.charAt(j) &&
                   (j - i < 2 || pal[i + 1][j - 1])){
                    pal[i][j] = true;
                }
            }
        }

        return solve(s, k, 0, k - 1);
    }

    int solve(String s, int k, int i, int j){
        if(i >= n || j >= n){
            return 0;
        }

        if(dp[i][j] != -1){
            return dp[i][j];
        }

        if(pal[i][j]){
            int takeIt = 1 + solve(s, k, j+1, j+k);
            int grow = solve(s, k, i, j+1);
            int slide = solve(s, k, i+1, j+1);

            return dp[i][j] = Math.max(takeIt, Math.max(grow, slide));
        }

        int grow = solve(s, k, i, j+1);
        int slide = solve(s, k, i+1, j+1);

        return dp[i][j] = Math.max(grow, slide);
    }
}
