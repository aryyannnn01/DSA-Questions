3471. Find the Largest Almost Missing Integer

class Solution {
    public int largestInteger(int[] nums, int k) {

        int n = nums.length;
        int[] count = new int[51];
        int largest = -1;
        for(int x : nums){
            count[x]++;
        }

        for(int i = 0; i < n; i++)
            if(k == n || (count[nums[i]] == 1 && (k == 1 || i == 0 || i == n - 1)))
                largest = Math.max(largest , nums[i]);

        return largest;
    }
}
