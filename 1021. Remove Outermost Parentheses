1021. Remove Outermost Parentheses

class Solution {
    public String removeOuterParentheses(String s) {
        int n = s.length();
        int depth = 0;
        StringBuilder ans = new StringBuilder();
        for(int i = 0; i < n; i++){
            if(s.charAt(i) == '('){
                if(depth > 0){
                    ans.append('(');
                }
                depth++;
            } else{
                depth--;
                if(depth > 0){
                    ans.append(')');
                }
            }
        }

        return ans.toString();        
    }
}
