3016. Minimum Number of Pushes to Type Word II

class Solution {
    public int minimumPushes(String word) {
        int[] mp = new int[26];;

        for(char ch : word.toCharArray()){
            mp[ch - 'a']++;
        }

        Integer[] freq = new Integer[26];
        for(int i = 0; i < 26; i++){
            freq[i] = mp[i];
        }

        Arrays.sort(freq, Collections.reverseOrder());

        int result = 0;
        for(int i = 0; i < 26; i++){
            int press = i / 8 + 1;
            result += press * freq[i];
        }

        return result;
    }
}
