3727. Maximum Alternating Sum of Squares

class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        for(int i = 0; i < n; i++){
            nums[i] *= nums[i];
        }
        Arrays.sort(nums);
        long score = 0;

        int positiveCount = (n + 1) / 2;

        for(int i = 0; i < n; i++){
            if(i < n -  positiveCount){
                score = score - nums[i];
            } else {
                score = score + nums[i];
            }
        }

        return score;
    }
}
